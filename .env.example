# CCNA Forge — variáveis de ambiente (exemplos)
# Copie para .env.local e preencha. NÃO commite .env.local nem secrets reais.
# NEXT_PUBLIC_* entram no bundle do static export (build-time na Vercel).

# ── Cliente (browser / static export) ─────────────────────────
# Auth + leitura de profiles (is_pro / pro_expires_at / trial).
# Sem estas, o app roda em modo offline (vidas localStorage), sem login/PRO sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe Payment Links (one-time). Abrir em nova aba a partir do Paywall/Conta/Home.
# Sem URL → alerta "link não configurado". Use links de Test mode para E2E local.
NEXT_PUBLIC_STRIPE_LINK_7D=
NEXT_PUBLIC_STRIPE_LINK_30D=
NEXT_PUBLIC_STRIPE_LINK_120D=

# ── NÃO colocar no client (só Supabase Edge Function secrets) ─
# Configurar no Dashboard Supabase → Edge Functions → stripe-webhook → Secrets
# (ou `supabase secrets set ...`). Nomes esperados pelo código:
#
#   STRIPE_SECRET_KEY          # sk_test_... / sk_live_...
#   STRIPE_WEBHOOK_SECRET      # whsec_... (endpoint do Stripe Dashboard)
#   SUPABASE_URL               # mesma URL do projeto (muitas vezes injetada)
#   SUPABASE_SERVICE_ROLE_KEY  # service_role — NUNCA no browser / NEXT_PUBLIC
#
# Webhook URL típica:
#   https://<project-ref>.supabase.co/functions/v1/stripe-webhook
# Evento: checkout.session.completed
#
# Matching: e-mail do checkout Stripe === e-mail da conta Auth (profiles.email).
# Duração PRO pelo amount_total (centavos BRL): 690→7d, 2090→30d, 5790→120d.
