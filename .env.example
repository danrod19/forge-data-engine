# CCNA Forge — variáveis de ambiente (exemplos)
# Copie para .env.local e preencha se necessário.
# NÃO commite .env.local nem secrets reais.

# ── Opcional no MVP free (app funciona sem elas) ─────────────
# Auth / perfil (Supabase). Se vazias, o client usa placeholder
# e login real não funciona — modos offline (localStorage) seguem ok.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe (NÃO obrigatório neste deploy) ────────────────────
# Preencher só quando for integrar checkout em produção.
# NEXT_PUBLIC_STRIPE_LINK_7D=
# NEXT_PUBLIC_STRIPE_LINK_30D=
# NEXT_PUBLIC_STRIPE_LINK_120D=
